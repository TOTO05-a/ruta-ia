NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://rutaia_user:CHANGE_ME@localhost:5432/rutaia
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rutaia_courses_openrouter_2048

N8N_COURSE_SYNC_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_24_CHARS
N8N_QUERY_WEBHOOK_URL=http://localhost:5678/webhook/rutaia-query
N8N_WEBHOOK_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_24_CHARS
N8N_CALLBACK_URL=http://host.docker.internal:3000/api/v1/internal/n8n/results
N8N_CALLBACK_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_24_CHARS
N8N_TIMEOUT_MS=10000

# OpenRouter es el proveedor de embeddings y generación. No pegues la clave en n8n.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
AI_CHAT_TIMEOUT_MS=120000
AI_EMBEDDING_TIMEOUT_MS=60000
# RAG_MIN_SIMILARITY es candidato local calibrado; repetir calibración al cambiar catálogo/modelo.

SESSION_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
SESSION_TTL_HOURS=168
# Opcional: habilita access tokens Bearer; debe ser distinto de SESSION_SECRET.
JWT_SECRET=
JWT_TTL_SECONDS=3600
FRONTEND_URL=http://localhost:3000
APP_PORT=3000
POSTGRES_PORT=5432
POSTGRES_USER=rutaia_user
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
RUTAIA_TEST_DATABASE_URL=
N8N_PORT=5678
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
GENERIC_TIMEZONE=America/Guatemala

# Candidate from local BGE-M3 calibration (rerun after changing catalog/model).
RAG_MIN_SIMILARITY=0.535
